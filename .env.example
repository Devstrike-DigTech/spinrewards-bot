# ─── Telegram ─────────────────────────────────────────────────────────────────
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
BOT_USERNAME=SpinRewardsGameBot

# ─── Mini App ─────────────────────────────────────────────────────────────────
MINI_APP_URL=https://app.spinrewardsgame.com

# ─── Backend API ──────────────────────────────────────────────────────────────
API_BASE_URL=https://api.spinrewardsgame.com/api/v1

# ─── Environment ──────────────────────────────────────────────────────────────
# 'development' uses long polling
# 'production'  uses webhooks
NODE_ENV=development

# ─── Webhook (production only) ────────────────────────────────────────────────
# Public HTTPS URL this bot server is reachable at
WEBHOOK_DOMAIN=https://bot.spinrewardsgame.com
WEBHOOK_PORT=3000

# ─── Internal Notify Endpoint ─────────────────────────────────────────────────
# Secret token to authenticate requests from backend → bot
NOTIFY_SECRET=your-strong-secret-here
INTERNAL_PORT=3001
